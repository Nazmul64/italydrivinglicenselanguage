<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop if already going to public/
    RewriteCond %{REQUEST_URI} !^/public/

    # Send all traffic to public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access to sensitive files
<FilesMatch "^\.env|composer\.(json|lock)|package\.(json|lock)|package-lock\.json|artisan|phpunit\.xml">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

